  "rules": [
    {
      "id": "R1",
      "type": "requires",
      "if": {
        "gradation_family": "OGFC"
      },
      "then": {
        "modifier_in": [
          "HVA"
        ]
      },
      "reason": "OGFC 空隙率约20%，需高粘高弹沥青保证集料粘结与抗飞散"
    },
    {
      "id": "R2",
      "type": "forbid",
      "if": {
        "gradation_family": "OGFC",
        "low_zone_in": [
          1
        ]
      },
      "reason": "冬严寒区排水路面易冻融堵塞与松散，不推荐"
    },
    {
      "id": "R3",
      "type": "forbid",
      "if": {
        "rap_gt": 0,
        "gradation_family_in": [
          "SMA",
          "OGFC"
        ]
      },
      "reason": "RAP 级配变异会破坏 SMA/OGFC 骨架结构"
    },
    {
      "id": "R4",
      "type": "forbid",
      "if": {
        "anti_rut": 1,
        "low_zone_in": [
          1
        ]
      },
      "reason": "冬严寒区使用抗车辙剂会加剧低温开裂风险"
    },
    {
      "id": "R5",
      "type": "forbid",
      "if": {
        "base": "50#",
        "low_zone_in": [
          1,
          2
        ]
      },
      "reason": "50# 硬质沥青低温延性差，不适用冬严寒/冬寒区"
    },
    {
      "id": "R6",
      "type": "forbid",
      "if": {
        "base": "110#",
        "high_zone_in": [
          1
        ]
      },
      "reason": "110# 软质沥青高温稳定性不足，不适用夏炎热区"
    },
    {
      "id": "R7",
      "type": "forbid",
      "if": {
        "gradation_family": "OGFC",
        "distress_in": [
          "water_damage"
        ],
        "structure_in": [
          "semi_rigid"
        ]
      },
      "reason": "水损害路段下卧层排水不畅时不宜直接加铺排水面层"
    },
    {
      "id": "R8",
      "type": "prefer",
      "if": {
        "traffic_in": [
          "特重",
          "极重"
        ],
        "layer": "上面层"
      },
      "then": {
        "modifier_not": [
          "none"
        ]
      },
      "reason": "特重及以上交通上面层应采用改性沥青"
    },
    {
      "id": "R9",
      "type": "forbid",
      "if": {
        "warm_mix": 1,
        "rap_gt": 20,
        "low_zone_in": [
          1
        ]
      },
      "reason": "原型保守规则：冬严寒区高RAP+温拌组合数据不足"
    },
    {
      "id": "R10",
      "type": "forbid",
      "if": {
        "rap_gt": 20,
        "traffic_in": [
          "特重",
          "极重"
        ]
      },
      "reason": "原型保守规则：特重及以上交通 RAP 掺量不宜超过 20%"
    }
  ]
